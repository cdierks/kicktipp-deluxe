{
  "name": "kicktipp-deluxe",
  "version": "5.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:deploy": "bash -n scripts/deploy/*.sh",
    "verify": "npm run test && npm run typecheck && npm run verify:deploy && npm run build",
    "start": "node .next/standalone/server.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "generate:clubs": "tsx scripts/generate-clubs.ts",
    "localize:clubs": "node scripts/localize-clubs.mjs",
    "mirror:club-icons": "node scripts/mirror-club-icons.mjs",
    "list:missing-club-icons": "node scripts/list-missing-club-icons.mjs",
    "generate:missing-club-icon-placeholders": "node scripts/generate-missing-club-icon-placeholders.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.34.5",
    "lucide-react": "^0.575.0",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "shadcn": "4.13.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
